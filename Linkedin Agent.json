        "promptType": "define",
        "text": "=Topic: {{ $json.Topic }}",
        "options": {
          "systemMessage": "You are an expert LinkedIn copywriter. \nYour job is to draft an engaging, authentic LinkedIn post based on the user's provided topic.\n\nGuidelines:\n- Lead with an attention-grabbing hook in the first 1-2 lines.\n- Break text into short, scannable paragraphs (1-3 sentences max).\n- Use bullet points where appropriate for key takeaways.\n- Include a thought-provoking closing question to drive comments.\n- Add 3 to 5 relevant hashtags at the end.\n- Output ONLY the draft post with no conversational preamble or metadata."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
